# Copy to .env (or set these in your host's dashboard). All are optional.

PORT=8080
DATABASE_PATH=data/musicsynq.db

# How long a party survives when the host's app drops offline, and how long a
# disconnected guest keeps their spot.
HOST_GRACE_SECONDS=120
GUEST_GRACE_SECONDS=600

# Push notifications (join requests, friend requests, "X started a party").
# Create a key at developer.apple.com > Certificates, IDs & Profiles > Keys,
# with "Apple Push Notifications service (APNs)" enabled.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.musicsynq
# Either the path to the downloaded AuthKey_XXXXXXXXXX.p8 file…
APNS_PRIVATE_KEY_PATH=
# …or its contents (newlines may be written as \n).
APNS_PRIVATE_KEY=
